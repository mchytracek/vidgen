{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidgen/storyboard.schema.json",
  "title": "vidgen Storyboard",
  "description": "Datenvertrag zwischen allen Phasen. Felder mit (auto) schreiben die Tools.",
  "type": "object",
  "required": ["title", "slug", "language", "format", "style", "compositor", "scenes"],
  "properties": {
    "title": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["brief", "story", "storyboard", "voice", "assets", "scenes", "review", "done"] },
    "language": { "type": "string", "description": "BCP-47, z. B. de" },
    "targetDuration": { "type": "number", "description": "Sekunden laut Brief" },
    "totalDuration": { "type": "number", "description": "(auto) Summe der Szenendauern" },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" }
      }
    },
    "style": {
      "type": "object",
      "required": ["imagePrompt"],
      "properties": {
        "imagePrompt": { "type": "string", "description": "Stil-Suffix für jeden Bildprompt" },
        "palette": {
          "type": "object",
          "properties": {
            "background": { "type": "string" },
            "foreground": { "type": "string" },
            "accent": { "type": "string" },
            "muted": { "type": "string" }
          }
        },
        "font": { "type": "string" },
        "characterRef": {
          "type": "string",
          "description": "Wiederkehrende Figur, relativ zu assets/ (z. B. images/character_ref.png) – aus einem Foto mit tools/character.py; Szenen mit visual.character bekommen sie per Qwen Image Edit"
        },
        "characterStyle": {
          "type": "string",
          "description": "Optional: Stil für die Umwandlung Foto → Figur (Default: imagePrompt)"
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "backend": { "enum": ["comfyui-chatterbox", "say"] },
        "reference": { "type": ["string", "null"], "description": "Pfad relativ zum Repo, z. B. voices/michael.wav" },
        "language": { "type": "string", "description": "ChatterBox-Sprachname, z. B. 'German (de)'" },
        "sayVoice": { "type": "string", "description": "macOS-Stimme für Backend say, z. B. Anna" },
        "seed": { "type": "integer" },
        "lexicon": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Aussprache-Lexikon nur für die Sprachausgabe: {\"DNS\": \"Deh-Enn-Ess\"} (ganze Wörter, ohne Groß/Klein)"
        },
        "params": {
          "type": "object",
          "description": "Zusätzliche ChatterBox-Node-Parameter, z. B. {\"temperature\": 0.55}"
        }
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tags": { "type": "string" },
        "bpm": { "type": "integer" },
        "volume": { "type": "number" },
        "file": { "type": ["string", "null"], "description": "(auto) relativ zu assets/" }
      }
    },
    "compositor": { "enum": ["remotion", "hyperframes", "tesseract"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narration", "visual"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{2,3}[a-z]?$" },
          "beat": { "type": "string" },
          "narration": { "type": "string" },
          "visual": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["image", "clip", "code", "hyperframes", "tesseract"] },
              "prompt": { "type": ["string", "null"] },
              "motionPrompt": { "type": ["string", "null"] },
              "seed": { "type": "integer" },
              "component": { "type": "string" },
              "props": {
                "type": "object",
                "description": "Komponenten-Props; bei Clips setzt comfy_assets.py ggf. playbackRate (< 1), weil LTX die letzten ~2 s abblendet"
              },
              "character": {
                "description": "Referenzfigur (style.characterRef) in dieses Bild einsetzen: true oder {wear, action, seed} (englisch)",
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "object",
                    "properties": {
                      "wear": { "type": "string", "description": "z. B. 'They wear the white beekeeper suit of <image1>.' (Default: Outfit der Referenz)" },
                      "action": { "type": "string", "description": "Mimik/Handlung, z. B. 'Eyes closed in bliss, licking the honey dipper.'" },
                      "seed": { "type": "integer" }
                    }
                  }
                ]
              }
            }
          },
          "onScreenText": { "type": "array", "items": { "type": "string" } },
          "transition": { "enum": ["cut", "fade", "slide", "wipe"] },
          "padAfter": { "type": "number" },
          "voice": {
            "type": "object",
            "description": "Stimm-Override nur für diese Szene, überschreibt storyboard.voice: {\"seed\": 2025, \"params\": {\"cfg_weight\": 0.3, \"exaggeration\": 0.35}}. cfg_weight niedriger = ruhiger/gedehnter, exaggeration niedriger = sachlicher.",
            "properties": { "seed": { "type": "integer" }, "params": { "type": "object" } }
          },
          "minDuration": { "type": "number" },
          "audioDuration": { "type": "number", "description": "(auto)" },
          "duration": { "type": "number", "description": "(auto) Sekunden" },
          "assets": {
            "type": "object",
            "description": "Pfade relativ zu assets/ – (auto) aus voiceover/comfy_assets; von Hand nur für eigene Medien in screens/ (Screenshots, Bildschirmaufnahmen)",
            "properties": {
              "image": { "type": "string" },
              "clip": { "type": "string" },
              "audio": { "type": "string" },
              "render": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
